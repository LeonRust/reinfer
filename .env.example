# reinfer 开发测试环境模板 —— 复制为 `.env`（已 gitignore）后使用。
# 加载方式：
#   - `reinfer` 二进制启动时自动读取本目录 `.env`（dotenvy；无文件时静默跳过）
#   - 手动真机命令：`set -a; . ./.env; set +a; <命令>`
# 注意：本文件仅是用户环境配置（文档示例范畴）；代码路径零模型标识（013 铁律）。

# ------------------------- 模型（013 ModelResolver） -------------------------
# 主源策略：modelscope 优先，缺模型/文件时回退 huggingface（auto 语义）
REINFER_MODEL_SOURCE=auto
# 下载/查找根缺省 ~/.reinfer/models（代码内默认值，不写模板；需要时再在此覆盖）
# 校验强度：sha256（ModelScope 官方）/ size / none（仅内网）
REINFER_MODEL_VERIFY=sha256
# 运行时缺模型自动下载；off=绝不联网（离线/管控环境）
REINFER_MODEL_AUTODOWNLOAD=on
# 调试模型（014 T9/T4 golden 等外部依赖）；验收阶段换 1.5B
REINFER_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
REINFER_MODEL_QUANT=q8_0
# 精确文件名（与 --quant 等价；如取消注释则优先生效）
# REINFER_MODEL_FILE=qwen2.5-0.5b-instruct-q8_0.gguf

# ------------------------- 网络出口（代理环境） -------------------------
HTTPS_PROXY=http://192.168.0.1:7890
HTTP_PROXY=http://192.168.0.1:7890
NO_PROXY=localhost,127.0.0.1,modelscope.cn,huggingface.co

# ------------------------- 工具链（Jit 自动选择；仅显式覆盖） -------------------------
# REINFER_CUDA_NVCC=/usr/local/cuda-12.8/bin/nvcc
# REINFER_CUDA_ARCH=sm_120a      # 未设置=设备实测 sm_{cc}；-a 仅需要 arch-specific 特性时

# ------------------------- L3 验收档（3× CPU 硬闸仅此档执行） -------------------------
# REINFER_MODEL_ACCEPT_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
# REINFER_MODEL_ACCEPT_QUANT=q8_0
