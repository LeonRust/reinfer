#!/usr/bin/env bash
# 宪法 §3.2 强制钩子：禁止任何 AI Co-Authored-By Trailer
# 安装：git config core.hooksPath .githooks
set -euo pipefail

msg_file="$1"

if grep -qiE '^Co-Authored-By:[[:space:]]*[^<]*<[^>]*@anthropic\.com>' "$msg_file" \
   || grep -qsiP 'Co-Authored-By:\s*Claude\s*<[^>]*>' "$msg_file"; then
  echo "⛔ 宪法 §3.2 违反：禁止 'Co-Authored-By: Claude <noreply@anthropic.com>'（或任何 AI 署名 Trailer）" >&2
  echo "   AI 参与情况请写在 PR 描述中，不要写入 commit message。" >&2
  exit 1
fi

# Conventional Commits 基本校验（宪法 §3.1）：type(scope): summary
head_line="$(awk 'NR==1' "$msg_file")"
if ! grep -qE '^(feat|fix|perf|refactor|docs|test|chore|ci|build)(\([a-z0-9_-]+\))?: .+' <<<"$head_line"; then
  echo "⛔ 宪法 §3.1 违反：首行须为 Conventional Commits（feat/fix/perf/refactor/docs/test/chore/ci/build(scope): summary）" >&2
  exit 1
fi

# 正文（body）必需（宪法 §3.1）：summary 后空一行 + 至少 10 个非空字符
if [ -n "$(sed -n '2p' "$msg_file")" ]; then
  echo "⛔ 宪法 §3.1 违反：summary 之后需空一行再写正文（body）" >&2
  exit 1
fi
BODY_CHARS="$(awk 'NR>2 { gsub(/[[:space:]]/, "", $0); n += length($0) } END { print n + 0 }' "$msg_file")"
if [ "$BODY_CHARS" -lt 10 ]; then
  echo "⛔ 宪法 §3.1 违反：正文（body）为空或过短（$BODY_CHARS < 10 字符）" >&2
  echo "   请写明：改了什么、为什么、验证要点（示例见 CONTRIBUTING.md §2）。" >&2
  exit 1
fi

exit 0
